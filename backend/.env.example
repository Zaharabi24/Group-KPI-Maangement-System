# ---------------------------------------------------------------------------
# ANWAR KPIFlow — backend environment
# Copy to `.env` and adjust. Never commit the real `.env` (NFR-SEC-04).
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=ANWAR KPIFlow
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:4000

# --- Database ---
# Local (docker compose) — service name `postgres`
DATABASE_URL=postgresql://anwar_kpi:anwar_kpi_secret@localhost:5432/anwar_kpi?schema=public
# Inside docker compose the host is `postgres`:
# DATABASE_URL=postgresql://anwar_kpi:anwar_kpi_secret@postgres:5432/anwar_kpi?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=anwar-kpi

# --- JWT / sessions (NFR-SEC-05) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_REFRESH_TTL=12h
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Password policy (FR-AUTH-05) ---
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=64
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300

# --- Email (NT-01 … NT-19) ---
# Development default is Mailpit (captures every message, no real delivery).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=ANWAR KPIFlow
MAIL_FROM_ADDRESS=no-reply@anwargroup.net
MAIL_REPLY_TO=hr@anwargroup.net
MAIL_ENABLED=true

# --- Evidence storage (FR-EVD-02) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/evidence
EXPORT_LOCAL_PATH=./storage/exports
EVIDENCE_MAX_SIZE_MB=10
EVIDENCE_MAX_FILES=5
EVIDENCE_URL_TTL_SECONDS=300
EVIDENCE_ENCRYPT_AT_REST=true
EVIDENCE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Organisation rules ---
ALLOWED_EMAIL_DOMAIN=anwargroup.net
WORKING_DAYS=0,1,2,3,4,6
TIMEZONE=Asia/Dhaka
FISCAL_YEAR_START_MONTH=1

# --- Seed accounts (development only) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@anwargroup.net
SEED_SUPER_ADMIN_PASSWORD=Anwar@KPI2026
SEED_DEMO_PASSWORD=Anwar@KPI2026
