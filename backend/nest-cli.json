{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "mailer/templates/**/*", "outDir": "dist/mailer/templates" },
      { "include": "assets/**/*", "outDir": "dist/assets" }
    ],
    "watchAssets": true
  }
}
